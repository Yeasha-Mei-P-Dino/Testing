import React, { useState } from 'react';
import { useDispatch, useSelector } from 'react-redux';
import { addTask } from './store/taskSlice';

function App() {
  const [taskInput, setTaskInput] = useState('');
  
  // Redux hooks
  const tasks = useSelector((state) => state.tasks);
  const dispatch = useDispatch();

  const handleAddTask = (e) => {
    e.preventDefault();
    
    // Requirement: Prevent adding empty tasks
    if (taskInput.trim() === '') return;

    dispatch(addTask(taskInput));
    setTaskInput(''); // Clear input
  };

  return (
    <div className="min-h-screen bg-emerald-50 font-['Poppins'] flex items-center justify-center p-6">
      <div className="w-full max-w-md bg-white rounded-3xl shadow-2xl overflow-hidden border-t-8 border-violet-600">
        
        {/* Header */}
        <div className="bg-violet-600 p-8 text-center">
          <h1 className="text-3xl font-bold text-white tracking-tight">Task Master</h1>
          <p className="text-emerald-200 text-sm mt-1">Organize your goals</p>
          <p className="text-emerald-100 text-sm mt-1"> by Yeasha Mei P. Diño </p>

        </div>

        <div className="p-8">
          {/* Input Section */}
          <form onSubmit={handleAddTask} className="flex gap-2 mb-8">
            <input
              type="text"
              placeholder="Add a new task..."
              className="flex-1 px-4 py-3 rounded-xl border-2 border-emerald-100 focus:border-violet-400 outline-none transition-all text-emerald-900"
              value={taskInput}
              onChange={(e) => setTaskInput(e.target.value)}
            />
            <button
              type="submit"
              className="bg-emerald-500 hover:bg-emerald-600 text-white font-bold px-6 py-3 rounded-xl transition-colors shadow-lg active:scale-95"
            >
              Add
            </button>
          </form>

          {/* Task List Section */}
          <div className="space-y-3">
            {tasks.length === 0 ? (
              <p className="text-center text-emerald-800/40 italic py-4">No tasks yet. Start being productive!</p>
            ) : (
              tasks.map((task) => (
                <div 
                  key={task.id} 
                  className="flex items-center p-4 bg-violet-50 rounded-xl border border-violet-100 animate-fadeIn"
                >
                  <div className="w-2 h-2 bg-emerald-500 rounded-full mr-4 shadow-[0_0_8px_rgba(16,185,129,0.6)]"></div>
                  <span className="text-violet-900 font-medium">{task.text}</span>
                </div>
              ))
            )}
          </div>
        </div>
        
        {/* Footer info */}
        <div className="bg-emerald-100/50 p-4 text-center">
          <span className="text-xs font-semibold text-emerald-700 uppercase tracking-widest">
            Total Tasks: {tasks.length}
          </span>
        </div>
      </div>
    </div>
  );
}

export default App;
