import { useState } from "react";
import bunny from "./Weather.png";

export default function App() {
  const [city, setCity] = useState("");
  const [weather, setWeather] = useState(null);
  const [loading, setLoading] = useState(false);
  const [error, setError] = useState("");

  // Replace with your own API key
  const API_KEY = "YOUR_API_KEY";

  const getWeather = async () => {
    if (!city) return;

    setLoading(true);
    setError("");
    setWeather(null);

    try {
      const response = await fetch(
        `https://api.openweathermap.org/data/2.5/weather?q=${city}&appid=${API_KEY}&units=metric`
      );

      if (!response.ok) {
        throw new Error("City not found");
      }

      const data = await response.json();

      setWeather({
        city: data.name,
        temp: data.main.temp,
        condition: data.weather[0].main,
      });
    } catch (err) {
      setError("City not found");
    } finally {
      setLoading(false);
    }
  };

  return (
    <div className="bg-violet-300 min-h-screen text-center pt-10 relative overflow-hidden">
      
      {/* Title */}
      <h1 className="text-7xl font-bold text-violet-950">
        Weather App
      </h1>

      {/* Search Box */}
      <div className="bg-green-200 w-[60%] mx-auto mt-10 rounded-3xl flex items-center p-5 shadow-lg">
        
        {/* Search Icon */}
        <button
          onClick={getWeather}
          className="text-6xl text-violet-900 mr-5 hover:scale-110 transition"
        >
          🔍
        </button>

        {/* Input */}
        <input
          type="text"
          placeholder="Search"
          value={city}
          onChange={(e) => setCity(e.target.value)}
          onKeyDown={(e) => e.key === "Enter" && getWeather()}
          className="bg-transparent outline-none text-5xl w-full text-violet-700 placeholder-violet-500"
        />
      </div>

      {/* Loading */}
      {loading && (
        <p className="text-2xl text-violet-950 mt-5">
          Loading...
        </p>
      )}

      {/* Error */}
      {error && (
        <p className="text-2xl text-red-600 mt-5">
          {error}
        </p>
      )}

      {/* Weather Card */}
      {weather && (
        <div className="bg-white w-[350px] mx-auto mt-8 p-6 rounded-3xl shadow-xl">
          <h2 className="text-3xl font-bold text-violet-900">
            {weather.city}
          </h2>

          <h1 className="text-6xl font-bold text-green-600 mt-3">
            {weather.temp}°C
          </h1>

          <p className="text-2xl text-violet-700 mt-2">
            {weather.condition}
          </p>
        </div>
      )}

      {/* Left Bunny */}
      <img
        src={bunny}
        alt="bunny"
        className="absolute left-0 bottom-0 w-60"
      />

      {/* Right Bunny */}
      <img
        src={bunny}
        alt="bunny"
        className="absolute right-0 bottom-0 w-60"
      />
    </div>
  );
}
